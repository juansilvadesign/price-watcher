# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Telegram bot token from @BotFather (looks like 123456789:AA...).
BOT_API_TOKEN=

# The chat the bot should SEND TO — your own chat id, not the bot's.
# Get it by messaging your bot once, then running:  python3 tools/telegram_chat_id.py
#
# ⛔ Exactly ONE chat id: yours. It is the critical recipient — a failure to reach it is
# what exit code 3 means. A comma-separated list here is refused at startup.
# Friends go in subscribers.json instead:  python3 tools/telegram_subscribers.py --pending
TELEGRAM_CHAT_ID=

# Which sinks fire, comma or space separated: console, telegram, toast.
# Keeps the crontab line short. --notifier on the CLI overrides this.
PRICEWATCH_NOTIFIERS=console,telegram,toast

# Optional: where the subscriber list lives (default: subscribers.json beside watch.py).
# PRICEWATCH_SUBSCRIBERS=
