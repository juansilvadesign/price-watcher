# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Telegram bot token from @BotFather (looks like 123456789:AA...).
BOT_API_TOKEN=

# The chat the bot should SEND TO — your own chat id, not the bot's.
# Get it by messaging your bot once, then running:  python3 tools/telegram_chat_id.py
TELEGRAM_CHAT_ID=

# Which sinks fire, comma or space separated: console, telegram, toast.
# Keeps the crontab line short. --notifier on the CLI overrides this.
PRICEWATCH_NOTIFIERS=console,telegram,toast
