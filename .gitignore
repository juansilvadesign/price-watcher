__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Price history is NOT versioned (Juan's call 2026-09-01): under a 30-minute cron it
# would make the repo dirty every half hour for a record nobody reads back.
# ⚠️ Consequence, stated plainly: these files now exist ONLY on this machine. There is
# no second copy. Losing the WSL disk loses the price record.
history/*.jsonl
history/*.log

# Secrets. The Telegram bot token lives here; it must never reach the repo,
# private or not. `.env.example` documents the keys and IS committed.
.env
.env.*
!.env.example
